<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_company_form_inherit_fx" model="ir.ui.view">
            <field name="name">res.company.form.inherit.fx.bureau.change</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="Bureau de change" groups="fx_bureau_change.group_fx_manager">
                        <group string="Comptabilisation">
                            <field name="fx_journal_id"/>
                            <field name="fx_margin_account_id"/>
                        </group>
                        <group string="Comptes de position par devise">
                            <field name="fx_currency_account_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="currency_id"/>
                                    <field name="account_id"/>
                                </list>
                            </field>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
