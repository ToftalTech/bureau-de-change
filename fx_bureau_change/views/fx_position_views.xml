<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_fx_position_list" model="ir.ui.view">
            <field name="name">fx.position.list</field>
            <field name="model">fx.position</field>
            <field name="arch" type="xml">
                <list string="Positions en devises" create="0" delete="0" default_order="currency_id">
                    <field name="currency_id"/>
                    <field name="quantity"/>
                    <field name="unit_cost"/>
                    <field name="value_xof" sum="Total"/>
                </list>
            </field>
        </record>

        <record id="view_fx_position_form" model="ir.ui.view">
            <field name="name">fx.position.form</field>
            <field name="model">fx.position</field>
            <field name="arch" type="xml">
                <form string="Position en devise" create="0" delete="0">
                    <sheet>
                        <group>
                            <field name="currency_id"/>
                            <field name="quantity"/>
                            <field name="unit_cost"/>
                            <field name="value_xof"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_fx_position" model="ir.actions.act_window">
            <field name="name">Positions en devises</field>
            <field name="res_model">fx.position</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_fx_position" name="Positions" parent="menu_fx_root"
                  action="action_fx_position" sequence="20"
                  groups="fx_bureau_change.group_fx_manager"/>

    </data>
</odoo>
